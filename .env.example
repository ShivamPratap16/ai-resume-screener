# Optional. Without it the pipeline runs fully rule-based.
ANTHROPIC_API_KEY=
# auto | true | false  (auto = use the LLM only when a key is present)
LLM_ENABLED=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_CONCURRENCY=4

# Optional. Raises the GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

SCREENER_CACHE_DIR=.cache

# Per-file parsing limit (seconds) and number of parser worker processes.
PARSE_TIMEOUT_S=20
PARSE_WORKERS=4
